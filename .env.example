# Copy this file to .env and fill in your own values. Never commit .env.

# Get a free token at https://www.travelpayouts.com (Tools -> API tokens, no card needed)
TRAVELPAYOUTS_TOKEN=

# Pick a private, hard-to-guess topic name, then subscribe to it in the ntfy iOS app
NTFY_TOPIC=morflights-changeme

# Comma-separated Moroccan departure airports
ORIGIN_AIRPORTS=CMN,RBA,RAK,TNG

CURRENCY=EUR
MAX_PRICE_EUR=250
MAX_STOPS=1
IMPROVEMENT_THRESHOLD_PCT=5

# How often the Docker scheduler re-checks prices (seconds). 6h default.
CHECK_INTERVAL_SECONDS=21600
